# ===========================================
# Inventory Management System — Environment
# ===========================================
# Copy this file to .env.local for local development.
# On Vercel: Project Settings → Environment Variables

# Neon PostgreSQL connection string (required)
# Get it from: https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: public app name shown in UI
NEXT_PUBLIC_APP_NAME="Inventory Management System"

# Optional: used if you add NextAuth later
# NEXTAUTH_SECRET="generate-a-long-random-string"
# NEXTAUTH_URL="https://your-app.vercel.app"
